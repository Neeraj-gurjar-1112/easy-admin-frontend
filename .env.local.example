# Copy to .env.local (never commit .env.local)

# Easy admin API root (Easy-Backend-v2: `npm run dev` → http://localhost:8080). HW2 only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/admin

# HW1: 1 = read the in-memory mock (src/mocks) instead of the API.
# The mock is also used automatically when NEXT_PUBLIC_API_BASE_URL is empty (e.g. the Vercel demo).
NEXT_PUBLIC_USE_MOCK=1
