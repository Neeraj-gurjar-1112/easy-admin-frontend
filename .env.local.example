# Copy to .env.local (never commit .env.local)

# Easy admin API root — Easy-Backend-v2: `node scripts/seed-delivery-agents.js && npm run dev` → http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/admin

# 0 = real API (default). 1 = demo mode: in-browser mock behind the same service contract, no login.
# Demo mode is also used automatically when NEXT_PUBLIC_API_BASE_URL is empty (e.g. a Vercel build without env).
NEXT_PUBLIC_USE_MOCK=0
